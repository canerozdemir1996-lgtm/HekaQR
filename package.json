    "preflight:stored-urls": "node scripts/preflight-stored-urls.mjs",
    "migration:inventory": "node scripts/migration-inventory.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-browser-extensions.ps1"
  },
  "engines": {
    "node": ">=22 <23"
  },
