{
  "name": "qr-publish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:test-catalog": "node scripts/generate-test-catalog.mjs",
    "bundle:tests": "node scripts/bundle-tests.mjs",
    "prebuild": "npm run generate:test-catalog && npm run bundle:tests",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
