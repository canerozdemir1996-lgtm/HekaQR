# ========================================
# QR Hub - 2026 Edition
# Environment Variables Setup
# ========================================

# SUPABASE - https://supabase.com/dashboard
# Settings > API'den al:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NEXTAUTH - ZATEN OLUŞTURULDU:
# Bu secret KULLANIL DEVAM EDİLİYOR:
NEXTAUTH_SECRET=WwOkCHdh9mbWC6mW0YS+kxnpls/IUaq1Pg++Ldkght0=
# Bu AYNI KALACAK. Değiştirme!

# Ortam URL'si:
NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://yourdomain.com

# GOOGLE OAUTH
# Setup: https://console.cloud.google.com/ (GOOGLE_OAUTH_SETUP.md dosyasını oku)
# OAuth 2.0 Client IDs > Web application
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GITHUB OAUTH  
# Setup: https://github.com/settings/developers (GITHUB_OAUTH_SETUP.md dosyasını oku)
# OAuth Apps > New OAuth App
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# ========================================
# ÇIZGİ TAMAMLAMA TALİMATLARI
# ========================================

# 1️⃣ SUPABASE SETUP (5 dakika):
#    ✓ https://supabase.com adres ziyaret
#    ✓ Free plan'da proje oluştur
#    ✓ Settings > API'ye  git
#    ✓ Copy et:
#      • "Project URL" → NEXT_PUBLIC_SUPABASE_URL
#      • "anon public key" → NEXT_PUBLIC_SUPABASE_ANON_KEY
#      • "service_role secret" → SUPABASE_SERVICE_ROLE_KEY
#
# 2️⃣ DATABASE SETUP (5 dakika):
#    ✓ COMPLETE_DATABASE_SETUP.sql dosyasını:
#      • Supabase SQL Editor aç
#      • Tüm SQL'i yapıştır ve çalıştır
#    ✓ SQL_SETUP_TEST_DATA.sql ile test verisi ekle:
#      • Test kullanıcı: test@example.com / test123
#      • 3 dummy QR kodu
#
# 3️⃣ GOOGLE OAUTH (5 dakika):
#    ✓ GOOGLE_OAUTH_SETUP.md'yi oku
#    ✓ https://console.cloud.google.com'da OAuth oluştur
#    ✓ Client ID ve Secret'ı buraya yapıştır
#
# 4️⃣ GITHUB OAUTH (5 dakika):
#    ✓ GITHUB_OAUTH_SETUP.md'yi oku
#    ✓ https://github.com/settings/developers'a git
#    ✓ OAuth App oluştur
#    ✓ Client ID ve Secret'ı buraya yapıştır
#
# 5️⃣ NEXTAUTH_CALLBACK_URLS (Notasyon/kontrol için):
#    ✓ Google: http://localhost:3000/api/auth/callback/google
#    ✓ GitHub: http://localhost:3000/api/auth/callback/github
#    ✓ Credentials: http://localhost:3000/api/auth/callback/credentials
#
# 6️⃣ TEST (5 dakika):
#    ✓ npm run dev
#    ✓ http://localhost:3000/login ziyaret
#    ✓ Email: test@example.com, Şifre: test123
#    ✓ Login tıkla → Dashboard'a git
#    ✓ 3 dummy QR kodu görmelisin
#
# ========================================
# SORUNLAR?
# ========================================
# "Supabase URL not configured" vs.
# → NEXT_PUBLIC_SUPABASE_URL'nin başına https:// var mı?
# → Supabase arka planda ID'sini kontrol et
#
# "Auth error: Invalid credentials"
# → Test kullanıcısı oluşturulmadı: SQL_SETUP_TEST_DATA.sql çalıştır
# → Supabase'de şifre hash'lendi mi? (crypt() fonksiyonu)
#
# "OAUTH ERROR"
# → Google Console'da Authorized redirect URIs doğru mu?
# → GitHub'da Authorization callback URL doğru mu?
# → Client ID/Secret copy-paste yapıldı mı?
# → NEXTAUTH_URL ayarlandı mı?
#
# ========================================
