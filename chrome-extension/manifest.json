{
  "manifest_version": 3,
  "name": "QR Publish — Hızlı QR Oluşturucu",
  "version": "1.0.0",
  "description": "Herhangi bir sayfayı veya bağlantıyı sağ tıkla saniyeler içinde QR koduna çevirin.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "activeTab", "storage", "downloads"],
  "host_permissions": ["http://qr.158.220.106.172.nip.io/*", "https://*.qrpublish.com/*"]
}
