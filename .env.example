# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXX

# Public app url
NEXT_PUBLIC_APP_URL=https://app.example.com
APP_URL=https://app.example.com

# Lemon Squeezy billing
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true

LEMONSQUEEZY_STARTER_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_STARTER_YEARLY_VARIANT_ID=
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_ENTERPRISE_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_ENTERPRISE_YEARLY_VARIANT_ID=

ENABLE_ENTERPRISE_SELF_SERVE_CHECKOUT=false
SALES_NOTIFICATION_EMAIL=

# Resend (admin bildirim e-posta kanalı — opsiyonel, key yoksa sessizce atlanır)
RESEND_API_KEY=
RESEND_FROM_EMAIL="QR Publish <bildirim@qrpublish.app>"

# GitHub Actions yedek workflow'larının (backup-db, backup-storage,
# restore-test, restore) sonuç raporu attığı /api/internal/backups/report rotasının
# paylaşılan token'ı — GitHub repo secrets'ında BACKUP_REPORT_TOKEN olarak
# aynısı tanımlanmalı. Boşsa rapor rotası 503 döner, /admin/backups boş kalır.
BACKUP_REPORT_TOKEN=

# GitHub Actions restore.yml workflow'unu sunucudan tetiklemek için PAT.
# Fine-grained PAT: repo > Actions (read+write) izni yeterli.
# Sadece sunucu .env.local'da kalır, GitHub secrets'a eklenmez.
GITHUB_ACTIONS_TOKEN=
# "kullaniciadi/repo-adi" — örn: acme/qrpublish
GITHUB_REPO=

# Sentry error tracking — opsiyonel, SENTRY_DSN boşsa Sentry tamamen devre
# dışı kalır (next.config.js Sentry plugin'ini hiç yüklemez, init() çağrılmaz).
SENTRY_DSN=
# Client-side hatalar için aynı DSN'i NEXT_PUBLIC_ prefix'iyle de tanımlayın
# (Next.js sadece NEXT_PUBLIC_* değişkenlerini browser bundle'ına gömer).
NEXT_PUBLIC_SENTRY_DSN=
# Sadece build sırasında sourcemap yüklemek için gerekli (opsiyonel).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sipariş/rezervasyon/geri bildirim webhook'larının HMAC imzası için paylaşılan secret.
WEBHOOK_SIGNING_SECRET=

# Custom domain doğrulandığında Vercel projesine otomatik eklemek için
# (opsiyonel) — boşsa custom domain DB'de "verified" işaretlenir ama
# Vercel'e bağlanmaz, kullanıcı DNS'i manuel yönlendirmesi gerekir.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# WhatsApp Business Cloud API (Meta) — opsiyonel, sipariş/rezervasyon
# bildirimleri için ek bir kanal. Anahtarlar yoksa sessizce atlanır.
# Kullanıcı ayarlarından WhatsApp numarasını girip aktifleştirebilir
# (profiles.notification_whatsapp_number).
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── SMS Sağlayıcıları ────────────────────────────────────────────────────────
# Öncelik sırası: Twilio → Netgsm → İleti Merkezi (username/password) → İleti Merkezi (key/hash) → Infobip
# Sadece aktif kullanmak istediğiniz sağlayıcının değişkenlerini doldurun.

# SMS_TEST_MODE=true → Gerçek SMS gönderilmez, sadece konsola log yazılır (development)
SMS_TEST_MODE=false
# İleti Merkezi — Eski format (key/hash) — geriye dönük uyumluluk
ILETIMERKEZI_KEY=1f086e15dfa9f058eb56a6c7c3274570
ILETIMERKEZI_HASH=4a63daf7f45f114cf645501ad11ce5b96848e593881ebee267680f860719d206
ILETIMERKEZI_SENDER=APITEST
