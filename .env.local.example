# =====================================================
# QR Hub - Supabase Bağlantı Bilgileri
# =====================================================
# Bu dosyayı ".env.local" olarak kaydedin
# Değerleri Supabase Dashboard > Settings > API'den alın
#
# Adımlar:
# 1. https://supabase.com/dashboard adresine gidin
# 2. Projenizi seçin
# 3. Sol menü: Settings > API
# 4. "Project URL" → NEXT_PUBLIC_SUPABASE_URL
# 5. "anon public" key → NEXT_PUBLIC_SUPABASE_ANON_KEY  
# 6. "service_role secret" key → SUPABASE_SERVICE_ROLE_KEY
# =====================================================

NEXT_PUBLIC_SUPABASE_URL=https://PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
